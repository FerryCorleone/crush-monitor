# Prefer the browser model settings after npm start.
# Optional legacy Jev settings below; browser-saved settings take precedence.
# Run npm run setup to configure Jev from the terminal.
# Choices: typesafe | vercel | openrouter | opencode | startlux. No URL or model setting needed.
# opencode uses the limited-time free Jev model only; it never falls back to paid models.
JEV_PROVIDER=typesafe
JEV_API_KEY=
# For StartLux on Bamboo, select JEV_PROVIDER=startlux and use its key above.
# Optional: STARTLUX_THINK_MODE=auto (default) or never (no thinking).
PORT=3178
HOST=127.0.0.1

# Optional Liquid AI native System One configuration (fixed d1-ultra model).
# Browser-saved settings take precedence. Never reuse another provider's key.
# CRUSH_PROVIDER=liquid
# LIQUID_API_KEY=
