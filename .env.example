# Prefer the browser model settings after npm start.
# Optional legacy Jev settings below; browser-saved settings take precedence.
# Run npm run setup to configure Jev from the terminal.
# Choices: typesafe | vercel | openrouter | opencode. No URL or model setting needed.
# opencode uses the limited-time free Jev model only; it never falls back to paid models.
JEV_PROVIDER=typesafe
JEV_API_KEY=
PORT=3178
HOST=127.0.0.1
